generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Board {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lists     BoardList[]
}

model BoardList {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]

  @@unique([boardId, position])
}

model Card {
  id          String    @id @default(uuid())
  listId      String
  list        BoardList @relation(fields: [listId], references: [id], onDelete: Restrict)
  title       String
  description String    @default("")
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([listId, position])
}
