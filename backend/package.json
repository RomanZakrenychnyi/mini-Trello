{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && concurrently -k -n compiler,server \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "prebuild": "prisma generate",
    "test": "npm run build && node --test test/*.e2e.cjs",
    "predb:migrate": "node scripts/prepare-db.cjs",
    "build:hosting": "prisma generate --schema prisma/postgres/schema.prisma && node scripts/build.cjs",
    "start:hosting": "prisma migrate deploy --schema prisma/postgres/schema.prisma && node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "prisma": "^6.19.3",
    "typescript": "~5.9.3"
  }
}
